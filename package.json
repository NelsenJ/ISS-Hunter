{
  "name": "iss-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "Game web multipemain: tebak posisi ISS beberapa menit ke depan.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
